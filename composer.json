{
    "name": "djl997/filament-model-activity-page",
    "description": "A reusable Filament v5 page that renders a chat-style activity feed for any Eloquent model with a polymorphic activities relation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Dirk Jan Laros",
            "email": "info@q2-software.nl"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "laravel/framework": "^12.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Djl997\\FilamentModelActivityPage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Djl997\\FilamentModelActivityPage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "pest",
        "test-coverage": "pest --coverage",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Djl997\\FilamentModelActivityPage\\FilamentModelActivityPageServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
